# Google Sheets (Step 1 setup)
# 1. Go to console.cloud.google.com
# 2. Create project → Enable Google Sheets API + Google Drive API
# 3. Create Service Account → Download JSON key
# 4. Share your Google Sheet with the service account email
GOOGLE_SHEETS_KEY_PATH=credentials.json
GOOGLE_SHEETS_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID

# Base currency for total portfolio value
BASE_CURRENCY=KRW

# USD/KRW rate fallback (auto-fetched via yfinance normally)
USDKRW_FALLBACK=1521.70
